    SOFT["<b>mask unused slots, ÷ T, softmax per question</b><br/>T = 1.760 / 1.251 / 1.983 · no params"]
    OUT["<b>typed answers</b><br/>route: billing 0.847 · urgency: score 3.331 · refund: 0.859<br/>output_tokens = 0"]
    ACT["<b>act / escalate head</b><br/>[CLS] + 4 features → 256 → GELU → 2<br/>263,938 params"]

