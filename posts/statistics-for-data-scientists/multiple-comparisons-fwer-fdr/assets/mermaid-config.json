{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Geist, 'Geist Fallback', system-ui, sans-serif",
    "fontSize": "15px",
    "background": "#f5f5f5",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#2d3142",
    "primaryBorderColor": "#2d3142",
    "secondaryColor": "#f5f5f5",
    "secondaryTextColor": "#2d3142",
    "secondaryBorderColor": "#4f5d75",
    "tertiaryColor": "#ececec",
    "tertiaryTextColor": "#2d3142",
    "tertiaryBorderColor": "#bfc0c0",
    "lineColor": "#4f5d75",
    "textColor": "#2d3142",
    "mainBkg": "#ffffff",
    "nodeBorder": "#2d3142",
    "clusterBkg": "#ececec",
    "clusterBorder": "#bfc0c0",
    "edgeLabelBackground": "#f5f5f5",
    "titleColor": "#2d3142",
    "actorBkg": "#ffffff",
    "actorBorder": "#2d3142",
    "actorTextColor": "#2d3142",
    "actorLineColor": "#7a8399",
    "signalColor": "#4f5d75",
    "signalTextColor": "#2d3142",
    "labelBoxBkgColor": "#ffffff",
    "labelBoxBorderColor": "#4f5d75",
    "labelTextColor": "#2d3142",
    "loopTextColor": "#2d3142",
    "noteBkgColor": "#ffffff",
    "noteBorderColor": "#eb6c36",
    "noteTextColor": "#2d3142",
    "activationBkgColor": "#ececec",
    "activationBorderColor": "#4f5d75",
    "sequenceNumberColor": "#ffffff"
  },
  "flowchart": {
    "curve": "step",
    "nodeSpacing": 40,
    "rankSpacing": 56,
    "padding": 12
  },
  "sequence": {
    "mirrorActors": false,
    "actorFontFamily": "Geist, system-ui, sans-serif",
    "messageFontFamily": "'Geist Mono', ui-monospace, monospace",
    "noteFontFamily": "Geist, system-ui, sans-serif"
  },
  "state": {
    "useMaxWidth": false
  },
  "er": {
    "useMaxWidth": false
  }
}
