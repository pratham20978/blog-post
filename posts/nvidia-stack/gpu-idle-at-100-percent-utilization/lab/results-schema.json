{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpu-idle-at-100-percent-utilization/results-schema.json",
  "title": "Tier B results: Why Your GPU Is Idle at 100% Utilization",
  "description": "What step_timing.py and util_probe.py write to results.json. No results.json ships with the lab: the authoring machine has no NVIDIA GPU, and no number is invented. Every duration is in milliseconds unless the name says otherwise.",
  "type": "object",
  "required": ["provenance"],
  "properties": {
    "provenance": {
      "description": "The provenance line. A result without it is not publishable.",
      "type": "object",
      "required": ["captured_at_utc", "gpu_name", "compute_capability", "sm_count", "kmd_version",
                   "cuda_umd_version", "torch_version", "torch_cuda_runtime", "cpu_model", "python_version"],
      "properties": {
        "captured_at_utc": {"type": "string", "description": "ISO 8601 timestamp of the run"},
        "gpu_name": {"type": "string"},
        "compute_capability": {"type": "string", "description": "sm_NN, as part 6 of the series writes it"},
        "sm_count": {"type": "integer"},
        "kmd_version": {"type": ["string", "null"], "description": "kernel-mode driver version, from NVML"},
        "cuda_umd_version": {"type": ["integer", "null"], "description": "the CUDA user-mode driver's ceiling, 1000*major + 10*minor, from NVML"},
        "torch_version": {"type": "string"},
        "torch_cuda_runtime": {"type": ["string", "null"], "description": "torch.version.cuda"},
        "cpu_model": {"type": ["string", "null"]},
        "python_version": {"type": "string"},
        "instance": {"type": ["string", "null"], "description": "free text from --instance, e.g. the rented instance type"}
      }
    },
    "step_timing": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "width": {"type": "integer"},
            "depth": {"type": "integer"},
            "parameter_tensors": {"type": "integer"},
            "batch": {"type": "integer"},
            "warmup_steps": {"type": "integer"},
            "measured_steps": {"type": "integer"}
          }
        },
        "sync_points": {
          "description": "what torch.cuda.set_sync_debug_mode('warn') reported for one as-written step",
          "type": "object",
          "properties": {
            "count": {"type": "integer"},
            "messages": {"type": "array", "items": {"type": "string"}}
          }
        },
        "variants": {
          "type": "object",
          "description": "keys: as-written, fix-1, fix-2, graph",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "phases": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "host_ms": {"type": ["number", "null"], "description": "median over measured steps, time.perf_counter"},
                    "event_ms": {"type": ["number", "null"], "description": "median over measured steps, CUDA events"},
                    "kernel_ms": {"type": ["number", "null"], "description": "the phase's kernels alone, queued behind a spin kernel"}
                  }
                }
              },
              "step_ms_host": {"type": ["number", "null"]},
              "step_ms_events": {"type": ["number", "null"]},
              "gpu_busy_ms": {"type": ["number", "null"], "description": "sum of kernel_ms"},
              "utilization_by_definition_pct": {"type": ["number", "null"], "description": "100 * gpu_busy_ms / step_ms_events"},
              "naive_loop_ms_per_step": {"type": ["number", "null"], "description": "loop timed on the host with no final synchronize"},
              "synced_loop_ms_per_step": {"type": ["number", "null"], "description": "the same loop, synchronized before the clock is read"}
            }
          }
        }
      }
    },
    "util_probe": {
      "type": "object",
      "properties": {
        "sample_interval_ms": {"type": "number"},
        "phases": {
          "type": "object",
          "description": "keys: idle, spin_one_thread, full_width, tiny_launches",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "nvml_gpu_util_pct_mean": {"type": ["number", "null"]},
              "nvml_gpu_util_pct_min": {"type": ["number", "null"]},
              "nvml_gpu_util_pct_max": {"type": ["number", "null"]},
              "samples": {"type": "integer"},
              "launches_per_second": {"type": ["number", "null"], "description": "tiny_launches only"},
              "estimated_kernel_busy_pct": {"type": ["number", "null"], "description": "tiny_launches only: launches/s x per-kernel GPU time"}
            }
          }
        }
      }
    }
  }
}
