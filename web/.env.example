# The FastAPI backend. Server-side only — never exposed to the browser.
BLOGS_API_URL=http://localhost:8000

# Public origin of THIS Next.js app. Must match BLOGS_OAUTH_REDIRECT_BASE_URL
# in the backend's .env, or the OAuth callback lands on the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header and footer.
NEXT_PUBLIC_SITE_NAME=Blogs

# Search has no backend yet (see docs). "mock" filters the cached feed
# client-side; "http" targets GET /api/v1/search once that endpoint exists.
NEXT_PUBLIC_SEARCH_ADAPTER=mock

# Where article data comes from. "fixtures" renders the whole site from typed
# sample data with no backend running; "api" reads from FastAPI. Server-side
# only, so one build can serve either.
BLOGS_DATA_SOURCE=fixtures
