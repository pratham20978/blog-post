# Optional overrides read by scripts/dev-up.sh after the normal .env file.
CANERLY_NETWORK=canerly_edge
DEV_POSTGRES_DB=blog-test
DEV_OBJECT_STORE_BUCKET=blogs-test

# Real OTP delivery is inherited from .env. Keep both of these disabled when
# BLOGS_EMAIL_PROVIDER=resend; startup rejects a plaintext or fixed-code bypass.
BLOGS_OTP_LOG_CODES=false
BLOGS_OTP_DEV_BYPASS_CODE=
BLOGS_ANNOUNCEMENT_SEND_RATE_PER_S=2

# Register these exact local callbacks with the providers:
# http://localhost:3001/api/v1/auth/oauth/google/callback
# http://localhost:3001/api/v1/auth/oauth/github/callback
