# Backend configuration. Copy to .env and fill in.
# Every value is validated at startup — a misconfigured deployment fails at
# assembly with a named field rather than at 3am inside a request.

BLOGS_ENVIRONMENT=local
BLOGS_DEBUG=true

# Serves /docs, /redoc and /openapi.json. Implied by BLOGS_DEBUG, so this only
# matters where debug is off — debug additionally allows every CORS origin, and
# publishing a schema is no reason to do that. compose.yaml turns it on for the
# deployed API; set it to false here to take the schema back off the internet.
BLOGS_DOCS_ENABLED=true

BLOGS_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/blogs

BLOGS_OBJECT_STORE_ENDPOINT=127.0.0.1:9002
BLOGS_OBJECT_STORE_ACCESS_KEY=
BLOGS_OBJECT_STORE_SECRET_KEY=
BLOGS_OBJECT_STORE_BUCKET=blogs
BLOGS_OBJECT_STORE_SECURE=false

# ── Email ────────────────────────────────────────────────────────────────────
# "none" installs an adapter that REFUSES every send. That is deliberate: a null
# adapter that accepted and dropped mail would make sign-in answer "a code is on
# its way" when nothing was sent.
BLOGS_EMAIL_PROVIDER=none

# Set both to switch it on. `onboarding@resend.dev` needs no DNS and delivers
# only to the Resend account owner — enough to exercise the whole path before a
# sending domain exists.
# BLOGS_EMAIL_PROVIDER=resend
# BLOGS_RESEND_API_KEY=re_xxxxxxxx
# BLOGS_EMAIL_FROM=Canerly <onboarding@resend.dev>
# BLOGS_EMAIL_REPLY_TO=

# Where an emailed link points — the reader-facing site, not this API.
BLOGS_PUBLIC_SITE_URL=http://localhost:3000

# Blast radius for one announcement, not a provider limit. Past it the request
# is refused outright rather than half-sent.
BLOGS_ANNOUNCE_MAX_RECIPIENTS=5000

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Logs the OTP code instead of needing email. Production refuses to start with
# this on.
BLOGS_OTP_LOG_CODES=true

# A fixed code accepted for ANY address, the admin included. It bypasses the
# challenge entirely. Production refuses to start with it set — that guard is
# the only reason it is acceptable at all.
BLOGS_OTP_DEV_BYPASS_CODE=000000

# ── OAuth (dormant until credentials exist) ──────────────────────────────────
# Must point at the Next.js origin, not this API: the backend's callback returns
# JSON, and the frontend shim turns it into cookies plus a redirect.
BLOGS_OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# BLOGS_GOOGLE_CLIENT_ID=
# BLOGS_GOOGLE_CLIENT_SECRET=
# BLOGS_GITHUB_CLIENT_ID=
# BLOGS_GITHUB_CLIENT_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
BLOGS_ADMIN_EMAIL=you@example.com

# Hashed once, when the admin row is FIRST created, then never read again.
# Editing it later changes nothing — use `python -m blogs.database.reset_admin_password`.
BLOGS_ADMIN_INITIAL_PASSWORD=

# The secret path every admin route is mounted under. Obscurity, not
# authentication: it stops scanners finding a login form, `require_admin` is
# what actually stops a non-admin. Production requires >= 16 characters and
# refuses anything guessable.
BLOGS_ADMIN_PATH_PREFIX=/change-me-to-something-unguessable

# ─────────────────────────────────────────────────────────────────────────────
# Deployment — read by compose.yaml only. Ignored when you run the app directly.
# ─────────────────────────────────────────────────────────────────────────────

# Every public name is derived from this one: canery.in, www, api, pgadmin,
# minioview, portainer. Changing it means reissuing the certificate.
DOMAIN=canery.in

# http until ./scripts/issue-certs.sh has run, https afterwards. The MinIO
# console and the backend's email links build absolute URLs from it, so a stale
# value here sends people to a scheme that is not being served.
PUBLIC_SCHEME=http

# The tunnel needs no value here: scripts/tunnel-setup.sh writes its credentials
# to deploy/cloudflared/ instead, because they are a key file rather than a
# string.
#
# Where Let's Encrypt sends expiry warnings. Unused while Cloudflare terminates
# TLS at its edge — see deploy/README.md before running scripts/issue-certs.sh.
CERTBOT_EMAIL=

# Postgres. These are the source of truth — compose builds the container's
# BLOGS_DATABASE_URL from them, because the one above points at 127.0.0.1 for
# running the app outside Docker, which inside a container is the container.
POSTGRES_DB=blogs
POSTGRES_USER=blogs
POSTGRES_PASSWORD=

# pgAdmin's own login at pgadmin.canery.in. Not a database account — it is the
# door to every database account, so give it a real password.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# What compose deploys. Pin to a version tag to make a rollback possible:
# `latest` is overwritten on every push, so it cannot be rolled back to.
BACKEND_IMAGE=prathamverma0803/blog-backend:latest
UI_IMAGE=prathamverma0803/blog-ui:latest

# The last MinIO release with a full admin console — later community builds
# removed user, policy and bucket management from the UI. Frozen, so it gets no
# upstream fixes; track a current tag if you would rather have patches and use
# `mc` for administration.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# The public bucket, served read-only at minio.canery.in/media/. Separate from
# BLOGS_OBJECT_STORE_BUCKET above, and that separation is load bearing: the
# backend's bucket holds article Markdown including unpublished drafts, so it
# must stay unreachable from outside. Only put bytes here that are meant to be
# fetched by a browser over a plain link.
MEDIA_BUCKET=media
